# 页面标题
VITE_APP_TITLE = '番剧聊天室'

# 开发环境配置
VITE_APP_ENV = 'development'

# 开发环境地址(前端项目前缀)
VITE_BASE_URL = '/dev/'

#服务器地址(网络请求服务器地址)
VITE_SERVE_URL = 'http://localhost:3000'

# 开发环境API(用于网络请求前缀)
VITE_BASE_API = '/api'

#网络请求超时
VITE_TIME_OUT = 10000

# Bangumi 地址：本地默认直连官方。若本地网络也访问不了 api.bgm.tv / lain.bgm.tv，
# 可改指向 Cloudflare Pages 反代（生产则走同源 /api/bgm，见 .env.production）：
# VITE_BANGUMI_BASE_URL = 'https://bgmapi-anime.pages.dev'
# VITE_BANGUMI_IMAGE_BASE_URL = 'https://bgmapi-anime.pages.dev'
# VITE_BANGUMI_TIMEOUT = 30000
