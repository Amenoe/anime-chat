VITE_APP_TITLE='动漫放映室'
VITE_APP_ENV='production'
VITE_BASE_URL='/'
VITE_SERVE_URL='http://8.130.120.172'
VITE_BASE_API='/api'
VITE_TIME_OUT=10000

# Bangumi 走同源反代：浏览器/服务器都直连不了 api.bgm.tv 与 lain.bgm.tv
# （DNS 污染 + SNI 阻断），由 nginx /api/bgm 与 /api/bgm-img 转发到 Cloudflare Pages。
VITE_BANGUMI_BASE_URL='/api/bgm'
VITE_BANGUMI_IMAGE_BASE_URL='/api/bgm-img'
# 反代链路实测 2–30s 抖动，10s 会把「慢」判成「失败」
VITE_BANGUMI_TIMEOUT=30000
